# Database (must match docker-compose `db` service and Moodle config.php)
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=change-me
MOODLE_DB_ROOT_PASSWORD=change-root-me
MOODLE_DB_HOST=db
MOODLE_DB_PORT=3306

# Public URL Moodle uses in links (use https://your-domain in production)
MOODLE_WWWROOT=http://localhost:8080

# Data directory inside containers (default matches compose volume mount)
MOODLE_DATAROOT=/var/moodledata

# Published ports
MOODLE_HTTP_PORT=8080
PHPMYADMIN_PORT=8081

# phpMyAdmin is behind profile "tools" — enable for local debugging only:
COMPOSE_PROFILES=tools

# Coolify / reverse proxy (set both to 1 when TLS terminates in front of Apache)
# MOODLE_REVERSE_PROXY=1
# MOODLE_SSL_PROXY=1
