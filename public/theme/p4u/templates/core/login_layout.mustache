{{!
    @template core/login_layout

    Centered login card on P4U brand gradient (overrides Boost split-screen).

    Context variables required for this template:
    * output - The core renderer output object (provides main_content).
}}
<div id="page-content" class="p4u-login-page">
    <div class="p4u-login-bg" aria-hidden="true">
        <div class="p4u-login-bg-gradient"></div>
        <div class="p4u-login-bg-pattern"></div>
        <div class="p4u-login-bg-orb p4u-login-bg-orb--top"></div>
        <div class="p4u-login-bg-orb p4u-login-bg-orb--bottom"></div>
    </div>

    <div class="p4u-login-center">
        <div class="p4u-login-card p4u-login-animate-in">
            <div class="p4u-login-brand">
                <div class="p4u-login-brand-logo">
                    <img class="p4u-login-logo" src="{{loginlogourl}}" alt="{{#str}}loginbrandtitle, theme_p4u{{/str}}">
                </div>
                <h1 class="p4u-login-title visually-hidden">{{#str}}loginbrandtitle, theme_p4u{{/str}}</h1>
                <p class="p4u-login-tagline">{{#str}}logintagline, theme_p4u{{/str}}</p>
            </div>

            <div id="region-main" class="p4u-login-main">
                <div id="region-main-box">
                    <div class="login-container">
                        {{{ output.main_content }}}
                    </div>
                </div>
            </div>
        </div>

        <p class="p4u-login-diakonie">{{#str}}logindiakonie, theme_p4u{{/str}}</p>
    </div>
</div>
